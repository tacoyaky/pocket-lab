{
  "manifest_version": 3,
  "name": "note Contest Tag Highlighter",
  "version": "0.1.0",
  "description": "Highlights note.com tags used by current contests and themes.",
  "permissions": ["alarms", "offscreen", "storage", "tabs"],
  "host_permissions": [
    "https://note.com/contests*",
    "https://editor.note.com/notes/*/publish/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://editor.note.com/notes/*/publish/*"],
      "js": ["src/content/content.js"],
      "css": ["styles/highlight.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "note Contest Tag Highlighter",
    "default_popup": "src/popup/popup.html"
  }
}
